{
 "schema_version": "1.0.0",
 "id": "broll_ingest_lint",
 "supersedes": "Replaces visual_blocks.lint_broll_prompt's 45-token rule (8-95 words, 46 tokens) as the ingest-level lint for AI B-roll prompts. visual_blocks.py is unchanged and keeps linting plate-level prompts only.",
 "_doc": "ONE contract for every AI B-roll prompt sent to Google Flow (read by scripts/tools/broll_from_video.py check-prompts). A prompt passes when it is English, 8-60 words, bound to an anchor_quote that appears in the slot text, and trips none of the rules below. Rule codes: NOT_ENGLISH, WORDS, EMPTY, ANCHOR_MISSING, ANCHOR_NOT_IN_TEXT, TEXT_IN_IMAGE, BRAND, FACE, R200. All token lists are lower-case; a token matches as a whole word (hyphen and space are interchangeable).",
 "language": "en",
 "min_words": 8,
 "max_words": 60,
 "require_anchor_quote": true,
 "plan": {
  "_doc": "Slot planning thresholds used by `analyze` (rules D1 and E2).",
  "min_broll_share": 0.25,
  "max_aroll_run_sec": 8.0,
  "long_talk_sec": 4.0,
  "min_block_sec": 3.0,
  "max_block_sec": 10.0
 },
 "rules": {
  "TEXT_IN_IMAGE": {
   "hint": "Video models paint garbled text, fake charts and chat bubbles. Describe pure physical scenes: people from behind, hands, objects, light, camera move.",
   "tokens": [
    "text",
    "texts",
    "subtitle",
    "subtitles",
    "caption",
    "captions",
    "label",
    "labels",
    "annotation",
    "annotations",
    "sign",
    "signs",
    "signage",
    "billboard",
    "banner",
    "poster",
    "posters",
    "logo",
    "logos",
    "watermark",
    "number",
    "numbers",
    "digit",
    "digits",
    "chart",
    "charts",
    "graph",
    "graphs",
    "dashboard",
    "dashboards",
    "metrics",
    "analytics",
    "statistics",
    "engagement",
    "ui",
    "interface",
    "screenshot",
    "screenshots",
    "note",
    "notes",
    "checklist",
    "checklists",
    "checkbox",
    "checkboxes",
    "written",
    "handwritten",
    "handwriting",
    "writing on paper",
    "bullet",
    "bullets",
    "chat",
    "chatting",
    "message",
    "messages",
    "messaging",
    "texting",
    "side-by-side",
    "comparison",
    "split screen",
    "price tag"
   ]
  },
  "BRAND": {
   "hint": "Never name a brand or platform; say 'an unbranded smartphone' or 'a generic laptop'.",
   "tokens": [
    "brand",
    "brands",
    "brand name",
    "brand names",
    "youtube",
    "tiktok",
    "facebook",
    "instagram",
    "zalo",
    "shopee",
    "lazada",
    "iphone",
    "macbook",
    "apple",
    "samsung",
    "google",
    "android",
    "windows",
    "microsoft",
    "amazon",
    "netflix",
    "chatgpt",
    "openai",
    "nike",
    "adidas",
    "coca-cola",
    "starbucks",
    "vinfast",
    "game character"
   ]
  },
  "FACE": {
   "hint": "Keep faces out of AI B-roll (the speaker's face lives in the A-roll): over the shoulder, from behind, hands only, silhouette.",
   "tokens": [
    "face",
    "faces",
    "facial",
    "headshot",
    "headshots",
    "selfie",
    "selfies",
    "portrait",
    "portraits",
    "looking at the camera",
    "looking into the camera",
    "looking straight at the camera",
    "staring at the camera",
    "smiling at the camera",
    "eye contact"
   ],
   "allowed_phrases": [
    "face out of frame",
    "face not visible",
    "faceless",
    "without showing the face",
    "face hidden",
    "face cropped out"
   ]
  },
  "R200": {
   "rule": "R200",
   "hint": "R200: AI B-roll is never proof. Do not generate before/after photos, results, screenshots, certificates, test reports or revenue visuals; use real user footage or a typographic block (metric_kpi_hero, versus_split_card) and set claim_gate.",
   "evidence_terms": [
    "before and after",
    "before-and-after",
    "before after",
    "after photo",
    "after photos",
    "before photo",
    "before photos",
    "testimonial",
    "testimonials",
    "customer review",
    "customer reviews",
    "five-star",
    "five star",
    "screenshot",
    "screenshots",
    "certificate",
    "certificates",
    "diploma",
    "lab result",
    "lab results",
    "test result",
    "test results",
    "x-ray",
    "xray",
    "blood test",
    "medical record",
    "medical records",
    "prescription",
    "invoice",
    "receipt",
    "bank statement",
    "income",
    "revenue",
    "profit",
    "profits",
    "sales figures",
    "dashboard",
    "growth",
    "conversion",
    "conversion rate",
    "roi",
    "percent",
    "case study",
    "proof",
    "evidence",
    "benchmark",
    "real customer",
    "real customers",
    "real patient",
    "real patients",
    "real client",
    "real clients",
    "actual results",
    "authentic results",
    "clinical",
    "clinical results",
    "verified"
   ]
  }
 },
 "claim_triggers": {
  "_doc": "Narration (Vietnamese, NFC, lower-case) that asserts a verifiable claim: the slot is then reported with claim_gate = true so EDITOR-REPORT asks for human verification.",
  "phrases": [
   "doanh thu",
   "lợi nhuận",
   "roi",
   "chuyển đổi",
   "tỷ lệ",
   "phần trăm",
   "kết quả",
   "trước và sau",
   "trước/sau",
   "khách hàng thật",
   "học viên",
   "bệnh nhân",
   "case study",
   "nghiên cứu",
   "thử nghiệm",
   "benchmark",
   "số liệu",
   "thống kê",
   "đã kiểm chứng",
   "chứng minh",
   "tăng gấp",
   "giảm còn",
   "miễn phí",
   "bản trả phí"
  ],
  "regex": [
   "\\d+(?:[.,]\\d+)?\\s*(?:%|phần trăm|triệu|tỷ|nghìn|k\\b)"
  ]
 },
 "flow": {
  "_doc": "Google Flow (MCP google-flow, brain-side) request shape and credit maths. This tool never generates.",
  "model": "omni-flash",
  "aspect_ratio": "9:16",
  "upscale": "1080p",
  "outputs_default": 2,
  "min_sec": 3,
  "max_sec": 15,
  "base_sec": 10,
  "voice_pad_sec": 0.3,
  "rate_per_sec": 3,
  "rate_per_sec_long": 6
 }
}
